# Export these variables in your shell; this file is a reference, not auto-loaded.
FULFILIQ_DATA_DIR=./data
FULFILIQ_ARTIFACT_DIR=./artifacts
# Optional when running services separately; launcher generates a token automatically.
# FULFILIQ_WRITE_TOKEN=generate-a-long-random-local-value
# FULFILIQ_API_URL=http://127.0.0.1:8000
# FULFILIQ_API_PORT=8000
# FULFILIQ_CONSOLE_PORT=8501
# Durable cohort scoring (all paths local; no automatic model training)
# FULFILIQ_SCORING_MAX_ORDERS=2000
# FULFILIQ_OPERATIONS_DIR=./data/processed
